<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.patcsy88</groupId>
  <artifactId>pdfgen</artifactId>
  <version>0.2.0</version>
  <packaging>jar</packaging>

  <name>pdfgen</name>
  <description>Java bindings for pdfgen, loading the C ABI library through the Panama FFM API</description>
  <licenses>
    <license>
      <name>MIT</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
  </licenses>

  <properties>
    <!-- java.lang.foreign is final from Java 22; built and tested on 25. -->
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- The tests load this release build; override with -Dpdfgen.lib=... on other platforms. -->
    <pdfgen.lib>${project.basedir}/../target/release/libpdfgen_ffi.so</pdfgen.lib>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.testng</groupId>
      <artifactId>testng</artifactId>
      <version>7.11.0</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Linker.downcallHandle is a restricted method; Java 24+ warns without this flag. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <environmentVariables>
            <PDFGEN_LIB>${pdfgen.lib}</PDFGEN_LIB>
          </environmentVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
